# Copy to .env.local for local development (never commit real keys).
#
# Google Books (optional, raises the request quota). This key ships inside the app, so in the Google Cloud console
# restrict it to the Books API and to your site's address (HTTP referrer). On Cloudflare Pages add it as a build variable.
VITE_GOOGLE_BOOKS_API_KEY=

# New York Times Books API. LOCAL DEV ONLY: with this set, the app calls the NYT directly.
# In production leave it unset: the app calls /api/nyt (functions/api/nyt.js), which reads the secret NYT_API_KEY
# from Cloudflare Pages -> Settings -> Variables and Secrets (type: Secret), so the key never reaches the browser.
VITE_NYT_API_KEY=
