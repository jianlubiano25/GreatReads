+import type { EarnedPlant, GardenPeak, GardenState, ReadingState } from '../types';
+import { PLANTS, type Milestone } from '../data/gardenPlants';
+
+/**
+ * Garden rules, kept separate from the UI. Everything here is pure: same input -> same output, nothing is saved here.
+ *
+ *  - `peak` holds the highest numbers ever reached, so plants and the window vine never shrink when a streak resets.
+ *  - `earned` records each plant the first time its milestone is reached. Entries are only ever added.
+ *  - The first evaluation of an older save ("seeded" = false) backfills plants silently (no celebration pop-ups).
+ */
+
+export const emptyGarden = (): GardenState => ({
+  seeded: false,
+  earned: {},
+  peak: { streak: 0, tenPageDays: 0, finished: 0, week: 0 },
+});
+
+const dayNumber = (key: string): number => {
+  const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(key);
+  return m ? Date.UTC(+m[1], +m[2] - 1, +m[3]) / 86400000 : NaN;
+};
+
+/** Numbers read straight from the reading history. */
+export function readingMetrics(s: ReadingState, todayKey: string): GardenPeak {
+  const goal = s.goal > 0 ? s.goal : 1;
+  const metDays: number[] = [];
+  let tenPageDays = 0;
+  for (const [key, v] of Object.entries(s.dailyLog || {})) {
+    const pages = Number(v) || 0;
+    if (pages >= 10) tenPageDays++;
+    if (pages >= goal) {
+      const d = dayNumber(key);
+      if (Number.isFinite(d)) metDays.push(d);
+    }
+  }
+  metDays.sort((a, b) => a - b);
+  let streak = 0;
+  let run = 0;
+  let prev = NaN;
+  for (const d of metDays) {
+    run = d === prev + 1 ? run + 1 : 1;
+    prev = d;
+    if (run > streak) streak = run;
+  }
+  const today = dayNumber(todayKey);
+  const week = metDays.filter(d => d >= today - 6 && d <= today).length;
+  const status = s.status || {};
+  const hidden = s.hiddenBookIds || {};
+  const finished = Object.keys(status).filter(id => status[id] === 'done' && !hidden[id]).length;
+  return { streak, tenPageDays, finished, week };
+}
+
+function reached(m: Milestone, peak: GardenPeak): EarnedPlant['via'] | null {
+  if (m.start) return 'start';
+  if (m.streak != null && peak.streak >= m.streak) return 'streak';
+  if (m.days != null && peak.tenPageDays >= m.days) return 'days';
+  return null;
+}
+
+/**
+ * Returns the garden after taking the latest reading history into account.
+ * Returns the SAME object when nothing changed, so callers can skip a state update.
+ */
+export function evaluateGarden(s: ReadingState, todayKey: string): GardenState {
+  const g = s.garden;
+  const m = readingMetrics(s, todayKey);
+  const peak: GardenPeak = {
+    streak: Math.max(g.peak.streak, m.streak),
+    tenPageDays: Math.max(g.peak.tenPageDays, m.tenPageDays),
+    finished: Math.max(g.peak.finished, m.finished),
+    week: Math.max(g.peak.week, m.week),
+  };
+  let changed = !g.seeded || (Object.keys(peak) as (keyof GardenPeak)[]).some(k => peak[k] !== g.peak[k]);
+  const earned = { ...g.earned };
+  for (const plant of PLANTS) {
+    if (earned[plant.id]) continue; // each milestone is awarded exactly once
+    const via = reached(plant.milestone, peak);
+    if (!via) continue;
+    earned[plant.id] = { at: todayKey, via, seen: !g.seeded || via === 'start' };
+    changed = true;
+  }
+  return changed ? { seeded: true, earned, peak } : g;
+}
+
+/** Used for the very first state (before the first paint) so plants are never missing for a frame. */
+export function withGarden(s: ReadingState, todayKey: string): ReadingState {
+  const garden = evaluateGarden(s, todayKey);
+  return garden === s.garden ? s : { ...s, garden };
+}
+
+/** Restoring a backup can add plants but never remove ones already earned on this device. */
+export function mergeGarden(current: GardenState, incoming: GardenState): GardenState {
+  const earned: Record<string, EarnedPlant> = { ...incoming.earned };
+  for (const [id, e] of Object.entries(current.earned)) {
+    earned[id] = earned[id] ? { ...e, seen: e.seen || earned[id].seen } : e;
+  }
+  return {
+    seeded: current.seeded || incoming.seeded,
+    earned,
+    peak: {
+      streak: Math.max(current.peak.streak, incoming.peak.streak),
+      tenPageDays: Math.max(current.peak.tenPageDays, incoming.peak.tenPageDays),
+      finished: Math.max(current.peak.finished, incoming.peak.finished),
+      week: Math.max(current.peak.week, incoming.peak.week),
+    },
+  };
+}
+
+/** Repairs anything read from storage or a pasted backup. Never throws. */
+export function sanitizeGarden(raw: unknown): GardenState {
+  const out = emptyGarden();
+  if (!raw || typeof raw !== 'object' || Array.isArray(raw)) return out;
+  const r = raw as Record<string, any>;
+  out.seeded = !!r.seeded;
+  const n = (v: unknown) => (typeof v === 'number' && Number.isFinite(v) && v > 0 ? Math.floor(v) : 0);
+  if (r.peak && typeof r.peak === 'object') {
+    out.peak = { streak: n(r.peak.streak), tenPageDays: n(r.peak.tenPageDays), finished: n(r.peak.finished), week: Math.min(7, n(r.peak.week)) };
+  }
+  if (r.earned && typeof r.earned === 'object' && !Array.isArray(r.earned)) {
+    for (const [id, e] of Object.entries<any>(r.earned)) {
+      if (!e || typeof e !== 'object') continue;
+      out.earned[String(id)] = {
+        at: typeof e.at === 'string' ? e.at : '',
+        seen: e.seen !== false,
+        via: e.via === 'streak' || e.via === 'days' ? e.via : 'start',
+      };
+    }
+  }
+  return out;
+}
+
+/** Marks plants as "prompt shown". Returns the same object if there is nothing to change. */
+export function markSeen(g: GardenState, ids: string[]): GardenState {
+  let changed = false;
+  const earned = { ...g.earned };
+  for (const id of ids) {
+    if (earned[id] && !earned[id].seen) {
+      earned[id] = { ...earned[id], seen: true };
+      changed = true;
+    }
+  }
+  return changed ? { ...g, earned } : g;
+}
