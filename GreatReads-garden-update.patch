+import type { GardenPeak } from '../types';
+
+/**
+ * THE PLANT CATALOG.  To add a plant:
+ *   1. Add one entry to PLANTS below (order = the order plants grow in; ids must never change once shipped).
+ *   2. Add its artwork to PLANT_ART in components/gardenArt.tsx under the same id.
+ * Nothing else needs to change: the shelf, scrolling, rewards and saving all read from this list.
+ */
+
+/** When a plant is earned. Either condition is enough (like the original garden rules). */
+export interface Milestone {
+  start?: boolean; // given for free from day one
+  streak?: number; // longest reading streak (days, each meeting your daily goal)
+  days?: number; // number of days with 10+ pages read
+}
+
+export interface PlantDef {
+  id: string;
+  name: string;
+  emoji: string;
+  kind: 'shelf' | 'hanging';
+  group: 'leafy' | 'flower';
+  milestone: Milestone;
+  day: string; // name colour on the daytime scene  (>= 4.5:1 contrast)
+  night: string; // name colour on the night scene
+  stageStep?: number; // after being earned, +1 growth stage (max 4) per this many extra days
+  seedling?: { pot: string; rim: string; badge: string; badgeColor?: string }; // look while still growing
+}
+
+export const PLANTS: PlantDef[] = [
+  { id: 'pot-sprout', name: 'Streak Sprout', emoji: '🌱', kind: 'shelf', group: 'leafy', milestone: { start: true }, day: '#226a27', night: '#9be08f' },
+  { id: 'pot-blossom', name: 'Pink Blossom', emoji: '🌸', kind: 'shelf', group: 'flower', milestone: { start: true }, day: '#a02a58', night: '#f6a6c4' },
+  { id: 'pot-pothos', name: 'Pothos', emoji: '🌿', kind: 'hanging', group: 'leafy', milestone: { days: 1 }, day: '#1b6b55', night: '#6fd6b4', seedling: { pot: '#c8a574', rim: '#8a6a3e', badge: '10p' } },
+  { id: 'pot-sunflower', name: 'Golden Sunflower', emoji: '🌻', kind: 'shelf', group: 'flower', milestone: { streak: 7, days: 7 }, day: '#785200', night: '#f5c542', stageStep: 3, seedling: { pot: '#b88340', rim: '#e5a93c', badge: '7d' } },
+  { id: 'pot-rose', name: 'Velvet Rose', emoji: '🌹', kind: 'shelf', group: 'flower', milestone: { streak: 14, days: 14 }, day: '#a8102b', night: '#ff8596', stageStep: 4, seedling: { pot: '#9e4343', rim: '#d95d5d', badge: '14d' } },
+  { id: 'pot-snake', name: 'Snake Plant', emoji: '🪴', kind: 'shelf', group: 'leafy', milestone: { streak: 21, days: 21 }, day: '#14472f', night: '#66c791', seedling: { pot: '#d9e0db', rim: '#547d63', badge: '21d', badgeColor: '#335940' } },
+  // Placeholder milestones for the newer plants: change the numbers freely.
+  { id: 'pot-fern', name: 'Fern', emoji: '🌿', kind: 'shelf', group: 'leafy', milestone: { streak: 30, days: 30 }, day: '#4a6a10', night: '#b5d96a', seedling: { pot: '#7a8f8a', rim: '#4f635f', badge: '30d' } },
+  { id: 'pot-monstera', name: 'Monstera', emoji: '🌿', kind: 'shelf', group: 'leafy', milestone: { streak: 45, days: 45 }, day: '#0f5a36', night: '#52c98a', seedling: { pot: '#e9d6bd', rim: '#8a5a3b', badge: '45d', badgeColor: '#5b3f26' } },
+  { id: 'pot-daisy', name: 'Daisy', emoji: '🌼', kind: 'shelf', group: 'flower', milestone: { streak: 60, days: 60 }, day: '#a04a00', night: '#ffb066', seedling: { pot: '#5f95a8', rim: '#3a6f80', badge: '60d' } },
+];
+
+export const PLANT_BY_ID: Record<string, PlantDef> = Object.fromEntries(PLANTS.map(p => [p.id, p]));
+
+/** Short line shown under a still-growing plant's name. */
+export function milestoneHint(m: Milestone): string {
+  if (m.days === 1 && m.streak == null) return 'Read 10 pages in a day';
+  return `Unlocks at ${m.streak ?? m.days} days`;
+}
+
+/** Longer description for tooltips / screen readers. */
+export function milestoneTitle(m: Milestone): string {
+  if (m.days === 1 && m.streak == null) return 'a day with 10+ pages';
+  if (m.streak != null && m.days != null && m.streak === m.days) return `${m.streak}-day streak or ${m.days} days with 10+ pages`;
+  if (m.streak != null) return `${m.streak}-day streak`;
+  return `${m.days} days with 10+ pages`;
+}
+
+/** "...for achieving your 7-day reading streak" */
+export function rewardReason(def: PlantDef, via: 'start' | 'streak' | 'days'): string {
+  const m = def.milestone;
+  if (via === 'streak' && m.streak != null) return `achieving your ${m.streak}-day reading streak`;
+  if (m.days === 1) return 'reading 10 pages in a day';
+  return `reading 10+ pages on ${m.days} different days`;
+}
+
+/** Growth stage 1-4 for plants that keep growing after they are earned. Based on peaks, so it never shrinks. */
+export function plantStage(def: PlantDef, peak: GardenPeak): number {
+  if (!def.stageStep) return 4;
+  const base = def.milestone.streak ?? def.milestone.days ?? 0;
+  const progress = Math.max(peak.streak, peak.tenPageDays);
+  return Math.max(1, Math.min(4, 1 + Math.floor((progress - base) / def.stageStep)));
+}
+
+/** How far along a not-yet-earned plant is: { value, target }. */
+export function plantProgress(def: PlantDef, peak: GardenPeak): { value: number; target: number } {
+  const m = def.milestone;
+  const target = m.streak ?? m.days ?? 0;
+  const value = Math.max(m.streak != null ? peak.streak : 0, m.days != null ? peak.tenPageDays : 0);
+  return { value: Math.min(value, target), target };
+}
