+/**
+ * The plant's emoji + name. It lives in a box exactly as wide as the plant and centres its text inside
+ * that box, so it is centred on the plant at any screen size. It is positioned absolutely (never moves
+ * the plants) and sits outside the swaying button (so it stays still while the plant sways).
+ * Shelf plants show it above; hanging plants show it below, because their cord is above.
+ */
+function PlantLabel({ plant, night, hint, hanging }: { plant: PlantDef; night: boolean; hint?: string; hanging: boolean }) {
+  return (
+    <div
+      aria-hidden="true"
+      className="absolute inset-x-0 z-30 flex justify-center pointer-events-none"
+      style={hanging ? { top: '100%' } : { bottom: hint ? 'calc(100% - 22px)' : '100%' }}
+    >
+      <div
+        className="animate-particle-float shrink-0 text-center whitespace-nowrap font-sans font-bold"
+        style={{ color: night ? plant.night : plant.day, fontSize: 12, lineHeight: 1.2 }}
+      >
+        {plant.emoji} {plant.name}
+        {hint && <div style={{ fontSize: 11, fontWeight: 500 }}>{hint}</div>}
+      </div>
+    </div>
+  );
 }
 
+interface GardenPlantProps {
+  plant: PlantDef;
+  peak: GardenPeak;
+  grown: boolean;
+  night: boolean;
+  streak: number; // only used by the Streak Sprout's tooltip
+  tap: Tap | undefined;
+  onTap: (id: string) => void;
