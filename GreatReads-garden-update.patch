+// ---- Garden plants -------------------------------------------------------------------------
+// The scene's own background follows the sky (cream by day, dark at night), not the app theme,
+// so every plant name has one colour for each (see data/gardenPlants.ts). All keep >= 4.5:1 contrast.
+const LABEL_MS = 1200; // how long a tapped plant's name stays on screen
+const SWAY_MS = 900; // how long a tapped plant sways
+const PLANT_W = 48; // every plant sits in a slot this wide, so spacing stays even and big gardens can be windowed
+const WINDOW_AFTER = 24; // only gardens bigger than this skip drawing off-screen artwork
+
+type Tap = { n: number; sway: boolean; label: boolean };
+
+/** Each plant keeps its OWN sway/label timers, so tapping one plant never cancels another's animation. */
+function usePlantTaps() {
+  const [taps, setTaps] = useState<Record<string, Tap>>({});
+  const timers = useRef<Record<string, { sway?: ReturnType<typeof setTimeout>; label?: ReturnType<typeof setTimeout> }>>({});
+  const count = useRef(0);
+  useEffect(
+    () => () => {
+      Object.values(timers.current).forEach(t => {
+        clearTimeout(t.sway);
+        clearTimeout(t.label);
+      });
+    },
+    [],
+  );
+  const onTap = useCallback((id: string) => {
+    try {
+      navigator.vibrate?.([15, 25]);
+    } catch {}
+    const t = timers.current[id] || (timers.current[id] = {});
+    clearTimeout(t.sway);
+    clearTimeout(t.label);
+    const n = ++count.current;
+    setTaps(p => ({ ...p, [id]: { n, sway: true, label: true } }));
+    t.sway = setTimeout(() => setTaps(p => (p[id] ? { ...p, [id]: { ...p[id], sway: false } } : p)), SWAY_MS);
+    t.label = setTimeout(
+      () =>
+        setTaps(p => {
+          if (!p[id]) return p;
+          const { [id]: _gone, ...rest } = p;
+          return rest;
+        }),
+      LABEL_MS,
+    );
+  }, []);
+  return [taps, onTap] as const;
+}
 
