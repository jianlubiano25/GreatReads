+import React from 'react';
+import type { GardenPeak } from '../types';
+
+/**
+ * Artwork for every garden plant. The plant list itself lives in data/gardenPlants.ts;
+ * each plant id there needs one entry in PLANT_ART at the bottom of this file.
+ * Everything is plain SVG: no animation loops, no images.
+ */
+
+export const Leaf = ({ x, y, r, c, s = 1.5 }: { x: number; y: number; r: number; c: string; s?: number }) => (
+  <ellipse cx={x} cy={y} rx={6 * s} ry={3.2 * s} transform={`rotate(${r} ${x} ${y})`} fill={c} />
+);
+
+/** Fade/scale-in used by parts that grow (leaves, buds). */
+export const grow = (on: boolean, visible: boolean, extra = ''): React.CSSProperties => ({
+  opacity: on && visible ? 1 : 0,
+  transform: on && visible ? 'scale(1)' : 'scale(0.2)',
+  transition: 'opacity .7s ease, transform .7s ease',
+  ...(extra ? { transformOrigin: extra } : {}),
+});
+
+export interface ArtProps {
+  stage: number; // 1-4, for plants that keep growing after they are earned
+  peak: GardenPeak; // highest numbers ever reached (never goes down)
+  grown: boolean; // false for the first frame so parts can grow in
+}
+
+// ---- Original plants (artwork unchanged; they now read the saved "highest ever" numbers) ----------
+
+function SproutArt({ peak }: ArtProps) {
+  const leaves = Math.min(8, 1 + peak.streak);
+  return (
+    <svg width={48} height={62} viewBox="0 0 50 62" aria-hidden="true">
+      <path d={`M25 40 L25 ${40 - leaves * 3}`} stroke="#2e5934" strokeWidth={2.5} strokeLinecap="round" />
+      {Array.from({ length: leaves }, (_, i) => (
+        <Leaf key={i} x={25 + (i % 2 ? 9 : -9)} y={38 - i * 3.6} r={i % 2 ? -35 : 35} c={['#3f6b45', '#4e7f55', '#5b9363', '#71ab7a'][i % 4]} s={1.5} />
+      ))}
+      {peak.streak >= 1 && (
+        <g>
+          <circle cx={25} cy={40 - leaves * 3 - 2} r={6} fill="#e7a1b4" />
+          <circle cx={25} cy={40 - leaves * 3 - 2} r={2.6} fill="#ffd66b" />
+        </g>
+      )}
+      {/* Terracotta Pot */}
+      <path d="M14 42 H36 L33 60 H17 Z" fill="#c26d45" />
+      <rect x={13.5} y={42} width={23} height={3.5} rx={1} fill="#ad5933" />
+    </svg>
+  );
+}
+
+function BlossomArt({ peak, grown }: ArtProps) {
+  const flowerG = grown ? Math.min(7, Math.max(0, peak.week)) / 7 : 0;
+  return (
+    <svg width={46} height={66} viewBox="0 0 48 66" aria-hidden="true">
+      <path
+        d="M24 46 C24 36 27 26 24 14"
+        stroke="#2e5934"
+        strokeWidth={2.4}
+        strokeLinecap="round"
+        pathLength={100}
+        strokeDasharray={`${Math.round((0.18 + flowerG * 0.82) * 100)} 100`}
+        style={{ transition: 'stroke-dasharray 1.2s ease' }}
+      />
+      {[0.25, 0.4, 0.55, 0.7, 0.85].map((t, i) => {
+        const y = 46 - t * 32;
+        const side = i % 2 ? 1 : -1;
