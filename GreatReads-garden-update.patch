+import React, { useEffect, useState } from 'react';
+import type { GardenState } from '../types';
+import { PLANT_BY_ID, rewardReason } from '../data/gardenPlants';
+
+interface Reward {
+  id: string;
+  emoji: string;
+  name: string;
+  reason: string;
+}
+
+/**
+ * "A new plant has arrived!" card. A plant is marked as seen the moment its card is first queued,
+ * so it can only ever appear once: reopening the app never shows it again.
+ */
+export function PlantRewardPrompt({ garden, onSeen }: { garden: GardenState; onSeen: (ids: string[]) => void }) {
+  const [queue, setQueue] = useState<Reward[]>([]);
+
+  useEffect(() => {
+    const fresh = Object.entries(garden.earned)
+      .filter(([id, e]) => !e.seen && PLANT_BY_ID[id])
+      .map(([id, e]): Reward => {
+        const def = PLANT_BY_ID[id];
+        return { id, emoji: def.emoji, name: def.name, reason: rewardReason(def, e.via) };
+      });
+    if (!fresh.length) return;
+    setQueue(q => [...q, ...fresh.filter(f => !q.some(x => x.id === f.id))]);
+    onSeen(fresh.map(f => f.id));
+  }, [garden.earned, onSeen]);
+
+  const current = queue[0];
+  if (!current) return null;
+
+  return (
+    <div
+      role="status"
+      aria-live="polite"
+      className="fixed inset-x-0 z-50 flex justify-center px-4 pointer-events-none"
+      style={{ top: 'calc(env(safe-area-inset-top, 0px) + 12px)' }}
+    >
+      <div
+        className="pointer-events-auto w-full max-w-sm rounded-2xl border p-4 shadow-lg"
+        style={{ background: 'var(--card-paper)', borderColor: 'rgba(138,90,59,.35)', color: 'var(--ink-dark)' }}
+      >
+        <p className="font-bold text-base">✨ A new plant has arrived! {current.emoji}</p>
+        <p className="mt-1 text-sm leading-snug">
+          You received a {current.name} for {current.reason}.
+        </p>
+        {queue.length > 1 && <p className="mt-1 text-xs opacity-70">{queue.length - 1} more waiting</p>}
+        <button
+          type="button"
+          onClick={() => setQueue(q => q.slice(1))}
+          className="mt-3 min-h-[44px] w-full rounded-xl px-4 text-sm font-bold"
+          style={{ background: 'var(--accent-soft)', color: 'var(--accent-green)' }}
+        >
+          {queue.length > 1 ? 'Next' : 'Lovely!'}
+        </button>
+      </div>
+    </div>
+  );
+}
