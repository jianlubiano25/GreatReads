+/** One plant on the shelf: a real <button> (keyboard + screen reader friendly) with its floating name. */
+const GardenPlant = memo(function GardenPlant({ plant, peak, grown, night, streak, tap, onTap, growing = false, lite = false }: GardenPlantProps) {
+  const hanging = plant.kind === 'hanging';
+  const stage = plantStage(plant, peak);
+  let title: string;
+  let ariaLabel: string;
+  let hint: string | undefined;
+  if (growing) {
+    const { value, target } = plantProgress(plant, peak);
+    const what = milestoneTitle(plant.milestone);
+    title = `${plant.name}: unlocks at ${what} (${value}/${target})`;
+    ariaLabel = `${plant.name}, still growing. Unlocks at ${what} (${value} of ${target}).`;
+    hint = milestoneHint(plant.milestone);
+  } else if (plant.id === 'pot-sprout') {
+    title = `${plant.name}: ${streak}-day streak. Tap to sway!`;
+    ariaLabel = `${plant.name}, ${streak}-day streak. Tap to sway.`;
+  } else if (plant.id === 'pot-blossom') {
+    title = `${plant.name}: ${peak.week}/7 goal days in your best week. Tap to sway!`;
+    ariaLabel = `${plant.name}, ${peak.week} of 7 goal days in your best week. Tap to sway.`;
+  } else if (plant.stageStep) {
+    title = `${plant.name} (Stage ${stage}/4) · Tap to sway!`;
+    ariaLabel = `${plant.name}, stage ${stage} of 4. Tap to sway.`;
+  } else {
+    title = `${plant.name} · Tap to sway!`;
+    ariaLabel = `${plant.name}. Tap to sway.`;
+  }
+
+  const Art = PLANT_ART[plant.id];
+  const motion = growing
+    ? 'opacity-70 hover:opacity-100 transition-opacity'
+    : `select-none transition-transform ${tap?.sway ? (tap.n % 2 ? 'animate-plant-sway' : 'animate-plant-sway-b') : 'hover:scale-105 active:scale-95'}`;
+
+  return (
+    <div className="relative shrink-0" style={{ width: PLANT_W }}>
+      <button
+        type="button"
+        onClick={() => onTap(plant.id)}
+        title={title}
+        aria-label={ariaLabel}
+        className={`block mx-auto cursor-pointer rounded-md focus-visible:outline-2 focus-visible:outline-offset-2 ${motion}`}
+        style={{ outlineColor: night ? '#e8dcc6' : '#2e5934', transformOrigin: hanging ? '50% 0' : undefined }}
+      >
+        {lite ? (
+          <span className="block" style={{ width: PLANT_W, height: hanging ? 78 : 68 }} />
+        ) : growing || !Art ? (
+          <SeedlingArt {...(plant.seedling || { pot: '#b88340', rim: '#e5a93c', badge: '?' })} />
+        ) : (
+          <Art stage={stage} peak={peak} grown={grown} />
+        )}
+      </button>
+      {tap?.label && <PlantLabel key={tap.n} plant={plant} night={night} hint={hint} hanging={hanging} />}
+    </div>
+  );
+});
